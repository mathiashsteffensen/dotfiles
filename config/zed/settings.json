{
  "markdown_preview": {
    "font_family": "Fira Code"
  },
  "ui_font_family": "Fira Code",
  "ui_font_weight": 500.0,
  "disable_ai": false,
  "git": {
    "diff_base": "head",
  },
  "proxy": "",
  "edit_predictions": {
    "zed": {
      "prediction_debounce": 400,
    },
    "provider": "zed",
  },
  "format_on_save": "on",
  "cli_default_open_behavior": "new_window",
  "icon_theme": "Zed (Default)",
  "auto_install_extensions": {
    "dockerfile": true,
    "html": true,
    "ruby": true,
    "terraform": true,
  },
  "languages": {
    "Shell Script": {
      "tab_size": 2,
      "hard_tabs": false,
    },
    "Ruby": {
      "language_servers": ["ruby-lsp", "rubocop", "!solargraph", "..."],
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "rubocop",
          "arguments": [
            "--autocorrect",
            "--stdin",
            "{buffer_path}",
            "--stderr",
          ],
        },
      },
    },
  },
  "lsp": {
    "ruby-lsp": {
      "settings": {
        "use_bundler": false,
      },
    },
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "base_keymap": "JetBrains",
  "vim_mode": true,
  "terminal": {
    "font_family": "Fira Code",
    "font_size": 13.0,
    "font_weight": 500,
  },
  "ui_font_size": 13.0,
  "buffer_font_family": "Fira Code",
  "buffer_font_size": 12.0,
  "buffer_font_weight": 500,
  "theme": {
    "mode": "dark",
    "light": "Ayu Mirage",
    "dark": "Ayu Dark",
  },
  "file_types": {
    "Helm": [
      "**/templates/**/*.tpl",
      "**/templates/**/*.yaml",
      "**/templates/**/*.yml",
    ],
  },
}
