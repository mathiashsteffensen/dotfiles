{
  "git": {
    "diff_base": "head"
  },
  "agent": {
    "sandbox_permissions": {
      "allow_unsandboxed": true
    },
    "profiles": {
      "sandbox": {
        "name": "Sandbox",
        "tools": {},
        "enable_all_context_servers": false,
        "context_servers": {}
      }
    },
    "default_model": {
      "effort": "high",
      "provider": "openrouter",
      "model": "deepseek/deepseek-v4.1-flash-1017",
      "enable_thinking": true
    },
    "favorite_models": [
      {
        "provider": "openrouter",
        "model": "deepseek/deepseek-v4.1-flash-1017",
        "enable_thinking": true,
        "effort": "high"
      },
      {
        "provider": "lmstudio",
        "model": "qwen/qwen3.6-35b-a3b",
        "enable_thinking": false
      },
      {
        "provider": "openai-subscribed",
        "model": "gpt-6-astra",
        "enable_thinking": true,
        "effort": "medium"
      },
      {
        "provider": "openai-subscribed",
        "model": "gpt-6.1-sol",
        "enable_thinking": true,
        "effort": "low"
      },
      {
        "provider": "openai-subscribed",
        "model": "gpt-6-luna",
        "enable_thinking": true,
        "effort": "medium"
      }
    ],
    "model_parameters": [],
    "show_turn_stats": true
  },
  "agent_servers": {
    "julia": {
      "args": [
        "--prompt"
      ],
      "type": "custom",
      "command": "/Users/mathias/go/bin/julia"
    }
  },
  "proxy": "",
  "edit_predictions": {
    "zed": {
      "prediction_debounce": 100
    },
    "provider": "zed",
  },
  "format_on_save": "on",
  "cli_default_open_behavior": "new_window",
  "icon_theme": "Zed (Default)",
  "auto_install_extensions": {
    "dockerfile": true,
    "html": true,
    "ruby": true,
    "terraform": true,
  },
  "languages": {
    "Ruby": {
      "language_servers": ["ruby-lsp", "rubocop", "!solargraph", "..."],
      "format_on_save": "on",
      "formatter": {
        "external": {
          "command": "rubocop",
          "arguments": [
            "--autocorrect",
            "--stdin",
            "{buffer_path}",
            "--stderr",
          ],
        },
      },
    },
  },
  "lsp": {
    "ruby-lsp": {
      "settings": {
        "use_bundler": false,
      },
    },
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "session": {
    "trust_all_worktrees": true,
  },
  "base_keymap": "JetBrains",
  "terminal": {
    "font_size": 13.0,
  },
  "ui_font_size": 14.0,
  "buffer_font_size": 14.0,
  "theme": {
    "mode": "dark",
    "light": "Ayu Mirage",
    "dark": "Ayu Dark",
  },
  "file_types": {
    "Helm": [
      "**/templates/**/*.tpl",
      "**/templates/**/*.yaml",
      "**/templates/**/*.yml",
    ],
  },
}
