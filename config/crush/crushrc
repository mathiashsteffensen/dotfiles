#!/usr/bin/env bash

lsp add gopls --command gopls

lsp add ruby-lsp --command ruby-lsp \
  --filetypes ruby \
  --filetypes eruby \
  --root-markers Gemfile \
  --root-markers .git \
  --init-options '{"formatter":"none","linters":[]}'

lsp add bashls --command bash-language-server --args start

lsp add terraformls --command terraform-ls --args serve

