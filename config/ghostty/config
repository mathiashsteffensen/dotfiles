command = /bin/bash

desktop-notifications = true

keybind = cmd+arrow_up=new_split:up
keybind = cmd+arrow_down=new_split:down
keybind = cmd+arrow_right=new_split:right
keybind = cmd+arrow_left=new_split:left
keybind = cmd+e=equalize_splits
keybind = cmd+f=toggle_split_zoom
keybind = cmd+ctrl+arrow_down=resize_split:down,25
keybind = cmd+ctrl+arrow_left=resize_split:left,25
keybind = cmd+ctrl+arrow_right=resize_split:right,25
keybind = cmd+ctrl+arrow_up=resize_split:up,25
