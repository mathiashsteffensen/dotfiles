command = /bin/bash

theme = meadow
window-translucent = true
window-theme = dark
dim-unfocused-terminals = false
font-family = Fira Code
font-size = 13
font-weight = 500
font-thicken = false

listen = tailnet://:7373

keybind = cmd+shift+f=find.open
keybind = cmd+right=pane.split.right
keybind = cmd+down=pane.split.down
keybind = cmd+f=pane.zoom
cursor-style = bar
copy-on-select = true
