(version 1)
(deny default)

; Plan mode: shell exploration without filesystem writes or network access.
; PROJECT_ROOT is passed as data by sandbox.ts; no path grants are needed.
(allow process-exec)
(allow process-fork)
(allow signal (target same-sandbox))
(allow process-info* (target same-sandbox))
(allow file-read*)
(allow file-read-metadata)

; Standard streams and character devices are not persistent storage.
(allow file-read* file-write* file-ioctl
  (literal "/dev/null")
  (literal "/dev/zero")
  (literal "/dev/random")
  (literal "/dev/urandom")
  (literal "/dev/tty")
  (literal "/dev/stdin")
  (literal "/dev/stdout")
  (literal "/dev/stderr")
  (literal "/dev/ptmx"))
(allow pseudo-tty)
(allow file-read* file-write* (regex #"^/dev/ttys[0-9]+"))
(allow file-ioctl (regex #"^/dev/ttys[0-9]+"))

(allow sysctl-read
  (sysctl-name-prefix "hw.")
  (sysctl-name-prefix "kern.")
  (sysctl-name-prefix "vm.")
  (sysctl-name-prefix "machdep.cpu."))
(allow mach-lookup (global-name "com.apple.system.opendirectoryd.libinfo"))
(allow mach-host*)
(allow iokit-open (iokit-registry-entry-class "RootDomainUserClient"))
(allow ipc-posix-sem)
