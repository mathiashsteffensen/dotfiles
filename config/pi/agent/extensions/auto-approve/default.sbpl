(version 1)
(deny default)

; Required for sandbox-exec itself to launch the wrapped process.
(allow process-exec)
(allow process-fork)
; `same-sandbox`, not `self`: the bash tool must be able to signal its own
; subprocess tree (timeouts, Ctrl-C, `kill` in a pipeline). Every reachable
; target is already inside this profile.
(allow signal (target same-sandbox))
(allow process-info* (target same-sandbox))

; Allow reads everywhere so agents can navigate the filesystem.
(allow file-read*)
(allow file-read-metadata)

; sandbox.ts converts these quoted markers to SBPL parameters before execution.
; Project paths are passed separately as data, never interpolated into policy.
(allow file-write* (subpath "<PROJECT_ROOT>"))

; `file-write*` covers `file-write-unlink`, so `rm -rf .git` would otherwise be
; allowed. Block it explicitly — the agent's recovery path is the git history.
(deny file-write* (subpath "<PROJECT_ROOT>/.git"))

; Allow specs to reach local Postgres; deny-default blocks all other network access.
(allow network-outbound (remote tcp "localhost:5432"))

; --- Runtime baseline -------------------------------------------------------
; Without these, ordinary tools fail in confusing ways instead of being
; contained: git dies with `could not open '/dev/null'`, xcrun cannot write its
; cache, and node/bun abort during startup (V8 sizes its heap from sysctl).
; Mirrors codex-rs/sandboxing/src/seatbelt_base_policy.sbpl (itself derived from
; Chrome's sandbox/policy/mac/common.sb) and the /dev fix in alpi 7a3cfe6.

; Character devices that CLI tools reopen for r+w. Not persistent storage —
; denying them buys no isolation, it only breaks well-behaved tools.
(allow file-read* file-write* file-ioctl
  (literal "/dev/null")
  (literal "/dev/zero")
  (literal "/dev/random")
  (literal "/dev/urandom")
  (literal "/dev/tty")
  (literal "/dev/stdin")
  (literal "/dev/stdout")
  (literal "/dev/stderr")
  (literal "/dev/ptmx"))

; Interactive shells and test runners need a pty; PTYs created before entering
; the sandbox lack the com.apple.sandbox.pty extension, so allow ioctl broadly
; on the slave devices.
(allow pseudo-tty)
(allow file-read* file-write* (regex #"^/dev/ttys[0-9]+"))
(allow file-ioctl (regex #"^/dev/ttys[0-9]+"))

; CPU/memory sizing and OS version queries. Codex enumerates ~45 names; the
; prefixes cover the same runtimes with less profile. Reads only, and network
; is denied, so this is a fingerprinting surface, not an exfil channel.
(allow sysctl-read
  (sysctl-name-prefix "hw.")
  (sysctl-name-prefix "kern.")
  (sysctl-name-prefix "vm.")
  (sysctl-name-prefix "machdep.cpu."))

; getpwuid/user lookups (git author, rbenv, `id`), host clock/CPU info for
; node's os.cpus(), clock and timer services, semaphores for worker processes.
(allow mach-lookup (global-name "com.apple.system.opendirectoryd.libinfo"))
(allow mach-host*)
(allow iokit-open (iokit-registry-entry-class "RootDomainUserClient"))
(allow ipc-posix-sem)

; Temp dirs. mktemp, xcrun's cache, npm/node caches and test fixtures all live
; here. /tmp is a symlink; the sandbox resolves it, hence both forms.
; ponytail: /private/var/folders is every local user's temp root, not just
; $TMPDIR — reads are already global so there is no confidentiality delta, but
; if multi-user integrity ever matters, pass `-D TMPDIR=$TMPDIR` from
; wrapWithSandbox and switch to (subpath (param "TMPDIR")).
(allow file-write* (subpath "/tmp") (subpath "/private/tmp") (subpath "/private/var/folders"))
